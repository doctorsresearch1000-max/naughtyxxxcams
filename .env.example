# Telegram Login Widget + Mini App (server secret — never commit real values)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=NaughtyXXXcamsbot

# Cloudflare Workers deploy (Wrangler / opennextjs-cloudflare) — shell & CI only, never commit.
# Wrangler reads CLOUDFLARE_API_TOKEN only (not api_token in wrangler.toml [vars]).
CLOUDFLARE_API_TOKEN=
# Optional if wrangler.jsonc already sets account_id; required for some CI setups.
CLOUDFLARE_ACCOUNT_ID=
